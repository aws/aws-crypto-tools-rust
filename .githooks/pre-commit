#!/usr/bin/env bash
# Pre-commit hook: formats every staged Rust file with rustfmt and
# re-stages it, so the commit captures the formatted version
# automatically.
#
# Skips entirely when no Rust files are staged. Operates only on the
# staged set, so unstaged work in other files is never silently swept in.
#
# To enable this hook after cloning, run once:
#     git config core.hooksPath .githooks

set -euo pipefail

# Edition matches mpl/Cargo.toml. Update if a future crate uses a
# different edition.
RUST_EDITION="2024"

# Toolchain must match CI, which installs dtolnay/rust-toolchain@stable
# (see .github/workflows/library_rust_tests.yml) and gates on
# `cargo fmt --all -- --check`. Without this pin, `rustfmt` resolves to
# whatever rustup default the developer happens to have. That matters
# beyond cosmetics: --edition controls PARSING, not style rules, so an
# older rustfmt accepts --edition 2024 yet still applies the pre-2024
# style edition and sorts `use` items lowercase-first. The hook would
# then reformat and re-stage files into a state CI rejects, silently, at
# commit time.
RUST_TOOLCHAIN="stable"

staged_rs=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$' || true)

if [ -z "$staged_rs" ]; then
    exit 0
fi

if ! rustfmt "+$RUST_TOOLCHAIN" --version >/dev/null 2>&1; then
    echo "[pre-commit] ERROR: cannot run 'rustfmt +$RUST_TOOLCHAIN'." >&2
    echo "[pre-commit] CI formats with the '$RUST_TOOLCHAIN' toolchain; committing" >&2
    echo "[pre-commit] with a different one produces diffs CI will reject." >&2
    echo "[pre-commit] Install it with: rustup toolchain install $RUST_TOOLCHAIN" >&2
    echo "[pre-commit] (and ensure rustfmt is invoked via the rustup shim)." >&2
    exit 1
fi

echo "[pre-commit] Formatting staged Rust files (rustfmt +$RUST_TOOLCHAIN)..."
while IFS= read -r file; do
    if [ -f "$file" ]; then
        rustfmt "+$RUST_TOOLCHAIN" --edition "$RUST_EDITION" "$file"
        git add "$file"
    fi
done <<< "$staged_rs"

echo "[pre-commit] Done."
