# Cargo build output
/target/

# Cargo.lock is committed for this crate and its example, as it is for esdk, mpl
# and prim. Both build cdylib/staticlib artifacts for C++ consumers, so they are
# applications rather than libraries, and a reproducible dependency set is the
# expected default. Without it CI re-resolved on every run, which let an upstream
# publish break the build with no change on our side.

# Compiled demo / test binaries (built via the Makefile)
/basic_hierarchical_keyring_example
/raw_aes_keyring_example
/test_esdk
/test_concurrency
/test_resource_leaks

# Object files / archives
*.o
*.a

# Coverage instrumentation output
*.profraw

# Agent tooling scratch / transcripts
.agent-reports/

# CMake build output
/build/
/build-cmake/

